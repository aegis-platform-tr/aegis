# AEGIS local-demo configuration. DEVELOPMENT ONLY: replace every value before any other use.
# Copy to .env (git-ignored). Values here are placeholders, not secrets.
AEGIS_PROFILE=local-demo
AEGIS_DB_SUPERUSER_PASSWORD=change-me-dev-only-superuser
AEGIS_DB_OWNER_PASSWORD=change-me-dev-only-owner
AEGIS_DB_APP_PASSWORD=change-me-dev-only-app
# At least 32 characters. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
AEGIS_JWT_SECRET=change-me-dev-only-0123456789abcdefghijklmnop
# Password given to the seeded development users (>= 12 chars).
AEGIS_DEV_PASSWORD=change-me-dev-only-password
